---
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/500.css';
import '@fontsource/stix-two-text/600.css';
import '@fontsource/stix-two-text/700.css';
import '@fontsource/stix-two-text/400-italic.css';
import 'katex/dist/katex.min.css';
import '../styles/report.css';
import SiteHeader from '../components/SiteHeader.astro';
import Contents from '../components/Contents.astro';
import Masthead from '../components/Masthead.astro';
import ReportFooter from '../components/ReportFooter.astro';
import Supplement from '../components/Supplement.astro';
import Introduction from '../components/sections/Introduction.astro';
import BenchmarkResults from '../components/sections/BenchmarkResults.astro';
import ExperimentSetup from '../components/sections/ExperimentSetup.astro';
import ScoreAndRanking from '../components/sections/ScoreAndRanking.astro';
import Findings from '../components/sections/Findings.astro';
import CapabilityDifferences from '../components/sections/CapabilityDifferences.astro';
import FailurePatterns from '../components/sections/FailurePatterns.astro';
import EmergingCapabilities from '../components/sections/EmergingCapabilities.astro';
import Safety from '../components/sections/Safety.astro';
import CaseStudies from '../components/sections/CaseStudies.astro';
import Conclusion from '../components/sections/Conclusion.astro';
import RelatedWork from '../components/sections/RelatedWork.astro';
import References from '../components/sections/References.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Evaluation of GPT-6-Astra on EBench: benchmark comparisons, embodied capabilities, and recorded execution evidence."
    />
    <title>How Frontier Large Language Models Reshape Embodied Policies</title>
    <script>
      import '../../.generated/runtime.js';
    </script>
  </head>
  <body data-toc-open="true">
    <a class="skip-link" href="#introduction">Skip to report</a>
    <canvas id="ambient-particles" aria-hidden="true"></canvas>
    <SiteHeader />
    <Contents />
    <div class="report-page">
      <Masthead />
      <main>
        <Introduction />
        <BenchmarkResults />
        <ExperimentSetup />
        <ScoreAndRanking />
        <Findings />
        <CapabilityDifferences />
        <FailurePatterns />
        <EmergingCapabilities />
        <Safety />
        <CaseStudies />
        <Conclusion />
        <RelatedWork />
        <References />
      </main>
      <ReportFooter />
    </div>
    <Supplement />
  </body>
</html>
