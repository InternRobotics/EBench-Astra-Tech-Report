---
import reportFigures from '../../dist/data/report-figures.json';
import onlineTotals from '../../dist/data/online-totals.json';
import { buildOverallRanking } from '../lib/overall-ranking.js';

const ranking = buildOverallRanking(reportFigures, onlineTotals);
const astra = ranking.find((model) => model.key === 'Astra (ICL)')!;
const successRate = (astra.sr * 100).toFixed(2);
---

<div class="overall-results">
  <div class="overall-comparison">
    <div
      class="table-scroll overall-table-scroll"
      tabindex="0"
      role="region"
      aria-label="Overall model comparison"
    >
      <table class="report-table report-table--plain" aria-label="Overall model comparison">
        <colgroup>
          <col class="overall-model-column" />
          <col />
          <col />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">Model</th>
            <th scope="col" aria-sort="descending">
              SR (%)
            </th>
            <th scope="col">Score</th>
          </tr>
        </thead>
        <tbody>
          {ranking.map(({ key, label, sr, score }, index) => (
            <tr class:list={{ highlight: key === 'Astra (ICL)' }}>
              <th scope="row">
                <span class="overall-rank">{index + 1}</span>
                {label}
                {key === 'AMapbot' && (
                  <sup class="overall-note-marker">
                    <a
                      id="comparison-note-ref"
                      href="#comparison-note"
                      aria-label="Footnote 1: AMapbot comparison scope"
                    >
                      1
                    </a>
                  </sup>
                )}
              </th>
              <td>{index === 0 ? <b>{(sr * 100).toFixed(2)}</b> : (sr * 100).toFixed(2)}</td>
              <td>{index === 0 ? <b>{score.toFixed(4)}</b> : score.toFixed(4)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="overall-summary">
    <h3>GPT-6-Astra + Single-shot In-Context Learning (ICL)</h3>
    <div class="overall-metrics">
      <div>
        <p class="overall-metric-label">Task-averaged success rate</p>
        <strong class="overall-success">
          {successRate}
          <span>%</span>
        </strong>
      </div>
      <div class="overall-score">
        <b>{astra.score.toFixed(4)}</b>
        <span class="overall-metric-label">Score</span>
      </div>
    </div>
    <p class="overall-ranking">
      GPT-6-Astra <strong>ranks third in success rate</strong> and <strong>second in Score</strong>{' '}
      in the overall comparison.
    </p>
  </div>
</div>

<style>
  .overall-results {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: 2.5rem;
  }

  .overall-results > * {
    min-width: 0;
  }

  .overall-table-scroll {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .overall-comparison table {
    width: 100%;
    min-width: 0;
    table-layout: fixed;
    font-size: 1rem;
  }

  .overall-model-column {
    width: 58%;
  }

  .overall-comparison :is(th, td) {
    padding-inline: clamp(0.3rem, 1vw, 0.65rem);
  }

  .overall-comparison tbody th {
    overflow-wrap: anywhere;
  }

  .overall-comparison td {
    white-space: nowrap;
  }

  .overall-rank {
    display: inline-block;
    min-width: 1.5em;
    color: var(--muted);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .overall-note-marker {
    margin-left: 0.1em;
    font-size: 0.75em;
    line-height: 0;
    vertical-align: super;
  }

  .overall-note-marker a {
    color: var(--accent);
    text-decoration: none;
    scroll-margin-top: 6rem;
  }

  .overall-summary {
    align-self: center;
  }

  .overall-summary h3 {
    margin: 0 0 1.75rem;
    font-size: clamp(1.5rem, 2.1vw, 1.875rem);
    line-height: 1.25;
    font-weight: 600;
    text-wrap: balance;
  }

  .overall-metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .overall-metric-label {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.4;
  }

  .overall-success {
    display: block;
    color: var(--accent);
    font-size: clamp(3.25rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .overall-success span {
    margin-left: 0.1em;
    font-size: 0.4em;
    letter-spacing: 0;
  }

  .overall-score {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    padding-bottom: 0.3rem;
  }

  .overall-score b {
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .overall-score .overall-metric-label {
    margin: 0;
  }

  .overall-ranking {
    margin: 1.5rem 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  @media (max-width: 48rem) {
    .overall-results {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
